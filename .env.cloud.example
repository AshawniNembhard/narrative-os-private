# Render sets these via render.yaml. NEVER commit your actual secrets.
CLOUD_MODE=1
NARRATIVE_DB=/var/data/narrative.db
APP_PASSWORD=SET_A_UNIQUE_16_PLUS_CHARACTER_PASSWORD_IN_RENDER
APP_SESSION_SECRET=SET_A_LONG_RANDOM_SECRET_IN_RENDER
DISABLE_POLLING=1
ENABLE_REMOTE_MARKET=0
# Optional; requires separate OpenAI API billing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini