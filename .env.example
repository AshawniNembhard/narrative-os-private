# Optional configuration. python run.py reads a sibling .env file automatically.
# Zero API keys needed for web news discovery and public daily data.
PORT=8000
DISABLE_POLLING=0
# Default: every 15 minutes, with a minimum of 10 minutes.
POLL_INTERVAL_SECONDS=900
# Optional model slug exposed by your connected ChatGPT plan. By default, uses
# the first listed eligible model; use Data sources to connect your account.
SIWC_MODEL=
# Optional additional GDELT article discovery, not full-text verification.
ENABLE_GDELT=0
# Alternative, explicitly billed OpenAI API integration, not required when
# using eligible Sign in with ChatGPT local OAuth.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# v0.4: market price API requests are OFF by default. User-uploaded CSVs
# supply chart snapshots. Set to 1 to restore optional remote daily pricing.
ENABLE_REMOTE_MARKET=0